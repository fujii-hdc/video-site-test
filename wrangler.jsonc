{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "video-site-test",
  "account_id": "00f4ea6cc973725a3963d0c4b2606faf",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },

  // 管理画面から動画を出し入れするためのバケット接続。
  // これがあるので、R2のAPIキーをアプリに持たせる必要がない。
  "r2_buckets": [
    { "binding": "VIDEOS", "bucket_name": "video-site-test-samples" }
  ],

  // 動画の一覧・公開状態・並び順・視聴ログを持つデータベース。
  // database_id は `npm run setup:db` が自動で書き込む。
  "d1_databases": [
    { "binding": "DB", "database_name": "video-site-test-video-site-db", "database_id": "7bd12c4a-9d6b-42e7-a16f-80878425c19c" }
  ],


  // 環境変数。Cloudflare 上で使う値はここか、ダッシュボードの Variables で設定する。
  // 秘密情報（APIトークン等）は `npx wrangler secret put NAME` を使い、ここには書かないこと。
  "vars": {
    "VIDEO_PROVIDER": "r2",
    "ADMIN_USER": "hadmin",
    "R2_PUBLIC_BASE_URL": "https://pub-253a8870c5544610a28cafecf608e0d0.r2.dev"
  }
}
